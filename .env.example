# Copy to .env and fill in. NEVER commit .env.

# PostgreSQL (JDBC URL format, e.g. Neon/Supabase: jdbc:postgresql://HOST/DB?sslmode=require)
DATABASE_URL=jdbc:postgresql://localhost:5432/keyvault
DATABASE_USERNAME=keyvault
DATABASE_PASSWORD=change-me

# 32+ random bytes, base64. Generate: openssl rand -base64 32
# Encrypts TOTP seeds and keys anti-enumeration HMACs. Rotating it disables existing 2FA enrolments.
KEYVAULT_SERVER_KEY=

# Public URL users open in the browser (scheme + host [+ port]). Used for Origin checks.
KEYVAULT_APP_ORIGIN=https://keyvault.example.com

# Set to false after creating your accounts to run a private instance.
KEYVAULT_REGISTRATION_ENABLED=true

# "framework" ONLY behind a trusted reverse proxy (Render, Fly, Railway, Nginx); otherwise "none".
FORWARD_HEADERS_STRATEGY=none

# Prometheus scraping of /actuator/prometheus (blank = locked). Also write it to monitoring/metrics-token.
KEYVAULT_METRICS_TOKEN=
# Grafana admin password for the optional monitoring profile.
GRAFANA_ADMIN_PASSWORD=
